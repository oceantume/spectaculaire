---
import ArtistDialog from "../components/ArtistDialog.astro";
import PageNav from "../components/PageNav.astro";
import ScheduleTable from "../components/ScheduleTable.astro";
import allFestivals from "../content/festivals.json";
import Base from "../layouts/Base.astro";
import type { ArtistDetailsByName, Festival, Row } from "../types";

export function getStaticPaths() {
  const festivals = import.meta.env.DEV ? allFestivals : allFestivals.filter((f) => !f.draft);
  return festivals.map((f) => ({ params: { festival: f.slug }, props: { festival: f as Festival } }));
}

type Props = { festival: Festival };
const { festival } = Astro.props;

const scheduleModules = import.meta.glob<{ default: Row[] }>("../content/festivals/*/schedule.json", { eager: true });
const artistModules = import.meta.glob<{ default: ArtistDetailsByName }>("../content/festivals/*/artist-details.json", {
  eager: true,
});

const scheduleKey = Object.keys(scheduleModules).find((k) => k.includes(`/${festival.dataDir}/`));
const artistKey = Object.keys(artistModules).find((k) => k.includes(`/${festival.dataDir}/`));

const rawRows: Row[] = scheduleKey ? scheduleModules[scheduleKey].default : [];
const artistDetails: ArtistDetailsByName = artistKey ? artistModules[artistKey].default : {};

const schedule = new Map<string, Row[]>();
for (const row of rawRows) {
  const group = schedule.get(row.date);
  if (group) {
    group.push(row);
  } else {
    schedule.set(row.date, [row]);
  }
}

const otherFestivals = (import.meta.env.DEV ? allFestivals : allFestivals.filter((f) => !f.draft)).filter(
  (f) => f.slug !== festival.slug,
) as Festival[];
---

<Base title={festival.name} description={`Horaire de la programmation ${festival.name}`}>
  <main class="p-2 sm:p-4 dark:bg-gray-900 min-h-screen">
    <PageNav festival={festival} otherFestivals={otherFestivals} />
    <ScheduleTable schedule={schedule} artistDetails={artistDetails} slug={festival.slug} features={festival.features} />
    <ArtistDialog />
    {
      festival.sourceUrl && (
        <footer class="mt-8 text-center text-xs text-gray-600 dark:text-gray-400">
          Données tirées de{" "}
          <a
            href={festival.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-gray-700 dark:hover:text-gray-300"
          >
            {festival.sourceLabel}
          </a>{" "}
          · Contenu appartenant au {festival.sourceAttribution}
        </footer>
      )
    }
  </main>
  <script is:inline type="application/json" id="artist-details-data" set:html={JSON.stringify(artistDetails)} />
</Base>
