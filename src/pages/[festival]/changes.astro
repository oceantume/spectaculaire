---
import PageNav from "../../components/PageNav.astro";
import festivalData from "../../content/festivals.json";
import Base from "../../layouts/Base.astro";
import { getFestivalChangelog } from "../../lib/changelog";
import type { ChangelogCommit, Festival } from "../../types";

export function getStaticPaths() {
  const festivals = import.meta.env.DEV ? festivalData : festivalData.filter((f) => !f.draft);
  return festivals.map((f) => ({ params: { festival: f.slug }, props: { festival: f as Festival } }));
}

type Props = { festival: Festival };
const { festival } = Astro.props;

const changelog: ChangelogCommit[] = getFestivalChangelog(festival.dataDir);

const allFestivals = (import.meta.env.DEV ? festivalData : festivalData.filter((f) => !f.draft)) as Festival[];

const dateFormatter = new Intl.DateTimeFormat("fr-CA", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const showDateFormatter = new Intl.DateTimeFormat("fr-CA", {
  weekday: "long",
  day: "numeric",
  month: "long",
  timeZone: "UTC",
});

function formatCommitDate(isoDate: string): string {
  return dateFormatter.format(new Date(isoDate));
}

function formatShowDate(showDate: string): string {
  return showDateFormatter.format(new Date(`${showDate}T00:00:00Z`));
}

function formatFieldName(field: string): string {
  if (field === "time") return "Heure";
  if (field === "venue") return "Scène";
  if (field === "paid") return "Type";
  return field;
}

function formatPaid(value: string): string {
  return value === "true" ? "payant" : "gratuit";
}
---

<Base title={`Historique — ${festival.shortName}`} description={`Historique des changements de la programmation ${festival.name}`}>
  <main class="page-main">
    <PageNav festival={festival} allFestivals={allFestivals} />
    <div class="changes-header">
      <a href={`/${festival.slug}`} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Retour à la programmation
      </a>
      <h1 class="changes-title">Historique des changements</h1>
    </div>
    {
      changelog.length === 0 ? (
        <p class="empty-state">Aucun historique disponible.</p>
      ) : (
        <ol class="changelog">
          {changelog.map((entry) => (
            <li class="changelog-entry">
              <time class="entry-date" datetime={entry.date}>
                {formatCommitDate(entry.date)}
              </time>
              <ul class="change-list">
                {entry.changes.map((change) => (
                  <li class="change-item" data-type={change.type}>
                    <span class={`change-badge change-badge--${change.type}`}>
                      {change.type === "added" && "Ajouté"}
                      {change.type === "removed" && "Retiré"}
                      {change.type === "updated" && "Modifié"}
                    </span>
                    <span class="change-artist">{change.artist}</span>
                    <span class="change-show-date">· {formatShowDate(change.showDate)}</span>
                    {(change.time || (change.details && change.details.length > 0)) && (
                      <ul class="change-details">
                        {change.time && (
                          <li class="change-detail">
                            <span class="detail-field">Heure :</span>{" "}
                            {change.type === "removed"
                              ? <span class="detail-from">{change.time}</span>
                              : <span class="detail-to">{change.time}</span>}
                          </li>
                        )}
                        {change.details?.map((detail) => (
                          <li class="change-detail">
                            <span class="detail-field">{formatFieldName(detail.field)} :</span>{" "}
                            <span class="detail-from">
                              {detail.field === "paid" ? formatPaid(detail.from) : detail.from}
                            </span>
                            {" → "}
                            <span class="detail-to">
                              {detail.field === "paid" ? formatPaid(detail.to) : detail.to}
                            </span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</Base>

<style is:global>
  .page-main {
    padding: 0.5rem;
    min-height: 100vh;
    background-color: var(--bg);
  }

  .changes-header {
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--text-dim);
    text-decoration: none;
    margin-bottom: 0.75rem;
  }

  .back-link:hover {
    color: var(--text);
  }

  .changes-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
  }

  .empty-state {
    color: var(--text-dim);
    font-size: 0.875rem;
    padding: 2rem 0;
    text-align: center;
  }

  .changelog {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .changelog-entry {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .entry-date {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .change-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .change-item {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.375rem;
    font-size: 0.875rem;
  }

  .change-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    flex-shrink: 0;
  }

  .change-badge--added {
    color: #166534;
    background-color: #dcfce7;
  }

  .dark .change-badge--added {
    color: #bbf7d0;
    background-color: rgba(20, 83, 45, 0.4);
  }

  .change-badge--removed {
    color: #991b1b;
    background-color: #fee2e2;
  }

  .dark .change-badge--removed {
    color: #fca5a5;
    background-color: rgba(153, 27, 27, 0.4);
  }

  .change-badge--updated {
    color: #92400e;
    background-color: #fef3c7;
  }

  .dark .change-badge--updated {
    color: #fde68a;
    background-color: rgba(120, 53, 15, 0.4);
  }

  .change-artist {
    font-weight: 500;
    color: var(--text);
  }

  .change-show-date {
    color: var(--text-dim);
    font-size: 0.8125rem;
  }

  .change-details {
    list-style: none;
    width: 100%;
    margin-top: 0.125rem;
    padding-left: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .change-detail {
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .detail-field {
    font-weight: 500;
  }

  .detail-from {
    text-decoration: line-through;
    color: var(--text-muted);
  }

  .detail-to {
    color: var(--text-secondary);
  }
</style>
