---
import ArtistDialog from "../../components/ArtistDialog.astro";
import PageNav from "../../components/PageNav.astro";
import ScheduleTable from "../../components/ScheduleTable.astro";
import festivalData from "../../content/festivals.json";
import Base from "../../layouts/Base.astro";
import { getFestivalChangelog } from "../../lib/changelog";
import type { Festival, Row } from "../../types";
import { resolveVenue } from "../../types";

export function getStaticPaths() {
  const festivals = import.meta.env.DEV ? festivalData : festivalData.filter((f) => !f.draft);
  return festivals.map((f) => ({ params: { festival: f.slug }, props: { festival: f as Festival } }));
}

type Props = { festival: Festival };
const { festival }: Props = Astro.props;

const scheduleModules = import.meta.glob<{ default: Row[] }>("../../data/festivals/*/schedule.json", {
  eager: true,
});
const overrideModules = import.meta.glob<{ default: Record<string, Partial<Row>> }>(
  "../../data/festivals/*/field-overrides.json",
  { eager: true },
);
const venueOverrideModules = import.meta.glob<{ default: Record<string, string> }>(
  "../../data/festivals/*/venue-overrides.json",
  { eager: true },
);

const scheduleKey = Object.keys(scheduleModules).find((k) => k.includes(`/${festival.dataDir}/`));
const overridesKey = Object.keys(overrideModules).find((k) => k.includes(`/${festival.dataDir}/`));
const venueOverridesKey = Object.keys(venueOverrideModules).find((k) => k.includes(`/${festival.dataDir}/`));

const rawRows: Row[] = scheduleKey ? scheduleModules[scheduleKey].default : [];
const fieldOverrides = overridesKey ? overrideModules[overridesKey].default : {};
const venueOverrides = venueOverridesKey ? venueOverrideModules[venueOverridesKey].default : {};
const overridesByLower = Object.fromEntries(Object.entries(fieldOverrides).map(([k, v]) => [k.toLowerCase(), v]));

const schedule = new Map<string, Row[]>();
for (const row of rawRows) {
  const override = overridesByLower[row.artist.toLowerCase()];
  const resolvedVenue = resolveVenue(row.venue, venueOverrides);
  const resolvedRow = override ? { ...row, venue: resolvedVenue, ...override } : { ...row, venue: resolvedVenue };
  const group = schedule.get(row.date);
  if (group) {
    group.push(resolvedRow);
  } else {
    schedule.set(row.date, [resolvedRow]);
  }
}

const allFestivals = (import.meta.env.DEV ? festivalData : festivalData.filter((f) => !f.draft)) as Festival[];

const changelog = getFestivalChangelog(festival.dataDir);
const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const recentChangeCount = changelog
  .filter((entry) => new Date(entry.date) >= sevenDaysAgo)
  .reduce((sum, entry) => sum + entry.changes.length, 0);
---

<Base title={festival.name} description={`Horaire de la programmation ${festival.name}`}>
  <main class="page-main">
    <PageNav festival={festival} allFestivals={allFestivals} changesHref={changelog.length > 0 ? `/${festival.slug}/changes` : undefined} recentChanges={recentChangeCount} />
    <ScheduleTable schedule={schedule} slug={festival.slug} features={festival.features} />
    {!festival.features.includes("no-artist-dialog") && <ArtistDialog src={`/${festival.slug}/artist-details.json`} />}
    {
      festival.sourceUrl && (
        <footer class="page-footer">
          Données tirées de <a href={festival.sourceUrl} target="_blank" rel="noopener noreferrer" class="page-footer-link">{festival.sourceLabel}</a> · {festival.sourceAttribution}
        </footer>
      )
    }
  </main>
</Base>

<style is:global>
  .page-main {
    padding: 0.5rem;
    min-height: 100vh;
    background-color: var(--bg);
  }

  .page-footer {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--text-dim);
  }

  .page-footer-link {
    text-decoration: underline;
    color: inherit;
  }

  .page-footer-link:hover {
    color: var(--text-secondary);
  }
</style>
