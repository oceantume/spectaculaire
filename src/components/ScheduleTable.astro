---
import type { Row } from "../types";

type Props = {
  schedule: Map<string, Row[]>;
  slug: string;
  features: string[];
};

const { schedule, slug, features } = Astro.props;

function formatDayHeader(date: string): string {
  const [year, month, day] = date.split("-").map(Number);
  const d = new Date(year, month - 1, day);
  return d.toLocaleDateString("fr-CA", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

const hasFreeFilter = features.includes("filter-free");
const hasQuebecFilter = features.includes("filter-quebec");
const hasAllPaid = features.includes("all-paid");
const hasNoGenre = features.includes("no-genre");
---

<div data-schedule-wrapper data-schedule-slug={slug}>
  <script is:inline>
    (function () {
      try {
        var el = document.currentScript.parentElement;
        var slug = el.getAttribute('data-schedule-slug');
        if (JSON.parse(localStorage.getItem(slug + ':free'))) el.setAttribute('data-filter-free', '');
        if (JSON.parse(localStorage.getItem(slug + ':quebec'))) el.setAttribute('data-filter-quebec', '');
        if (JSON.parse(localStorage.getItem(slug + ':start'))) el.setAttribute('data-sort-by-start', '');
      } catch (_) {}
    })();
  </script>
  {
    (hasFreeFilter || hasQuebecFilter) && (
      <div data-filter-bar class="filter-bar">
        <button type="button" data-filter="all" class="filter-btn">
          Toute
        </button>
        {hasFreeFilter && (
          <button type="button" data-filter="free" class="filter-btn">
            Gratuit
          </button>
        )}
        {hasQuebecFilter && (
          <button type="button" data-filter="quebec" class="filter-btn">
            <img src="/qc.svg" alt="" class="qc-flag" />
            Québécois
          </button>
        )}
      </div>
    )
  }
  <table class="sched-table" data-schedule-table>
    <thead>
      <tr class="sched-thead-row">
        <th class="sched-th">Lieu</th>
        {!hasAllPaid && <th data-paid-header class="sched-th">Passe?</th>}
        <th data-sort-toggle class="sched-th sched-th-sort">
          <span data-sort-label style="view-transition-name: col-time">Début</span>
        </th>
        <th class="sched-th"><span style="view-transition-name: col-artist">Artiste</span></th>
        {!hasNoGenre && <th class="sched-th sched-th-genre"><span style="view-transition-name: col-genre">Genre</span></th>}
      </tr>
    </thead>
    {
      Array.from(schedule.entries()).map(([date, rows]) => (
        <tbody data-day={date}>
          <tr data-day-header data-date={date} class="sched-day-row">
            <th colspan={10} class="sched-day-cell">
              {formatDayHeader(date)}
            </th>
          </tr>
          {rows.map((row, idx) => (
              <tr
                id={`row-${row.date}-${idx}`}
                data-row
                data-date={row.date}
                data-paid={String(row.paid)}
                data-country={row.country ?? ""}
                data-non-quebec={row.country !== "Québec" ? "" : undefined}
                data-time={row.time}
                data-genre={row.genre}
                data-original-index={idx}
                class="sched-row"
              >
                  <td class="sched-td sched-td-venue">{row.venue}</td>
                  {!hasAllPaid && (
                    <td data-paid-cell class="sched-td">
                      {row.paid ? (
                        <span class="badge-paid">Payant</span>
                      ) : (
                        <span class="badge-free">Gratuit</span>
                      )}
                    </td>
                  )}
                  <td class="sched-td sched-td-time">{row.time}</td>
                  <td class="sched-td sched-td-artist">
                    <button type="button" data-artist-open={row.artist} class="artist-btn">
                      {row.country === "Québec" ? (
                        <>
                          <span class="artist-name">
                            {row.artist.slice(0, row.artist.lastIndexOf(" ") + 1)}
                            <span class="qc-nowrap">
                              {row.artist.slice(row.artist.lastIndexOf(" ") + 1)}
                            </span>
                          </span>
                          <img src="/qc.svg" alt="Québec" class="qc-flag-inline" />
                        </>
                      ) : (
                        <span class="artist-name">{row.artist}</span>
                      )}
                    </button>
                  </td>
                  {!hasNoGenre && <td class="sched-td sched-td-genre">{row.genre}</td>}
                </tr>
            ))}
        </tbody>
      ))
    }
  </table>
</div>
<script>
  import "../scripts/schedule-filter";
</script>

<style is:global>
  .filter-bar {
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem;
  }

  .filter-btn {
    cursor: pointer;
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--border-muted);
    color: var(--text-dim);
    background: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: background-color 0.15s;
  }

  .filter-btn:hover {
    background-color: var(--bg-hover);
  }

  [data-schedule-wrapper]:not([data-filter-free]):not([data-filter-quebec])
    [data-filter="all"].filter-btn {
    background-color: var(--filter-all-bg);
    color: var(--filter-all-text);
    border-color: var(--filter-all-border);
  }

  [data-filter-free] [data-filter="free"].filter-btn {
    background-color: var(--filter-free-bg);
    color: var(--filter-free-text);
    border-color: var(--filter-free-border);
  }

  [data-filter-quebec] [data-filter="quebec"].filter-btn {
    background-color: var(--filter-qc-bg);
    color: var(--filter-qc-text);
    border-color: var(--filter-qc-border);
  }

  [data-filter-free] [data-row][data-paid="true"] {
    display: none;
  }

  [data-filter-quebec] [data-row][data-non-quebec] {
    display: none;
  }

  [data-filter-free] [data-paid-header],
  [data-filter-free] [data-paid-cell] {
    display: none;
  }

  [data-filter-free]:not([data-filter-quebec])
    tbody:not(:has([data-row]:not([data-paid="true"]))) {
    display: none;
  }

  [data-filter-quebec]:not([data-filter-free])
    tbody:not(:has([data-row]:not([data-non-quebec]))) {
    display: none;
  }

  [data-filter-free][data-filter-quebec]
    tbody:not(:has([data-row]:not([data-paid="true"]):not([data-non-quebec]))) {
    display: none;
  }

  .qc-flag {
    height: 0.875rem;
    width: 0.625rem;
    display: inline-block;
  }

  .dark .qc-flag,
  .dark .qc-flag-inline {
    filter: brightness(1.5);
  }

  .sched-table {
    width: 100%;
    font-size: 0.875rem;
    line-height: 1.25rem;
    border-collapse: collapse;
  }

  .sched-thead-row {
    text-align: left;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sched-th {
    padding: 0.25rem 0.25rem;
    font-weight: 500;
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: var(--bg);
  }

  @media (min-width: 640px) {
    .sched-th {
      padding: 0.25rem 0.5rem;
    }
  }

  .sched-th-sort {
    cursor: pointer;
    user-select: none;
  }

  .sched-th-genre {
    display: none;
  }

  @media (min-width: 490px) {
    .sched-th-genre {
      display: table-cell;
    }
  }

  .sched-day-row {
    background-color: var(--bg-secondary);
  }

  .sched-day-cell {
    padding: 0.5rem 0.25rem;
    text-align: left;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: capitalize;
    position: sticky;
    top: 1.5rem;
    z-index: 10;
    background-color: var(--bg-secondary);
  }

  @media (min-width: 640px) {
    .sched-day-cell {
      padding: 0.5rem 0.5rem;
    }
  }

  .sched-row {
    scroll-margin-top: 8rem;
  }

  .sched-row:hover {
    background-color: var(--bg-hover);
  }

  :root {
    --row-flash-bg: #fef9c3;
    --row-flash-ring: #fde047;
  }

  .dark {
    --row-flash-bg: #422006;
    --row-flash-ring: #92400e;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes row-flash {
      0% {
        background-color: var(--row-flash-bg);
        box-shadow: inset 0 0 0 2px var(--row-flash-ring), inset 0 0 12px var(--row-flash-ring);
      }
      100% {
        background-color: transparent;
        box-shadow: inset 0 0 0 2px transparent, inset 0 0 12px transparent;
      }
    }

    .sched-row:target {
      animation: row-flash 1.5s ease-out;
    }

    [data-sort-pending] .sched-row:target {
      animation: none;
    }
  }

  .sched-td {
    padding: 0.25rem 0.25rem;
  }

  @media (min-width: 640px) {
    .sched-td {
      padding: 0.25rem 0.5rem;
    }
  }

  .sched-td-venue {
    color: var(--text-secondary);
  }

  .sched-td-time {
    font-variant-numeric: tabular-nums;
    color: var(--text-dim);
  }

  .sched-td-artist {
    font-weight: 500;
  }

  .sched-td-genre {
    color: var(--text-muted);
    display: none;
  }

  @media (min-width: 490px) {
    .sched-td-genre {
      display: table-cell;
    }
  }

  .badge-paid {
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background-color: var(--badge-paid-bg);
    color: var(--badge-paid-text);
  }

  .badge-free {
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background-color: var(--badge-free-bg);
    color: var(--badge-free-text);
  }

  .artist-btn {
    cursor: pointer;
    text-align: left;
    color: var(--text);
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .artist-name {
    text-decoration: underline;
  }

  .qc-nowrap {
    white-space: nowrap;
  }

  .qc-flag-inline {
    height: 1rem;
    width: 0.75rem;
    flex-shrink: 0;
  }

  [data-sort-by-start] [data-sort-label] {
    text-decoration: underline;
    color: var(--text);
  }
</style>
