---
import type { Festival } from "../types";

type Props = {
  festival: Festival;
  otherFestivals: Festival[];
};

const { festival, otherFestivals } = Astro.props;
---

<div class="nav-bar">
  <div class="festival-picker">
    <button type="button" class="festival-trigger" id="festival-trigger">
      <span class="trigger-full">{festival.name}</span>
      <span class="trigger-short">{festival.shortName}</span>
    </button>
    <select class="nav-select" id="festival-select" onchange="window.location.href = this.value" aria-label="Choisir un festival">
      <option value="" disabled selected>{festival.name}</option>
      {otherFestivals.map((f) => <option value={`/${f.slug}/`}>{f.name}</option>)}
    </select>
  </div>
  <button type="button" data-theme-toggle class="theme-btn" aria-label="Basculer le mode sombre">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class="icon-moon"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
    </svg>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class="icon-sun"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <line x1="12" y1="2" x2="12" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="12" y1="20" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="2" y1="12" x2="4" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="20" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="4.93" y1="4.93" x2="6.34" y2="6.34" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="17.66" y1="17.66" x2="19.07" y2="19.07" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="4.93" y1="19.07" x2="6.34" y2="17.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="17.66" y1="6.34" x2="19.07" y2="4.93" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    </svg>
  </button>
</div>
<script>
  import "../scripts/theme";
</script>
<script>
  const trigger = document.getElementById("festival-trigger");
  const select = document.getElementById("festival-select");
  if (trigger && select) {
    trigger.addEventListener("click", () => (select as HTMLSelectElement).showPicker());
  }
</script>

<style>
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .festival-picker {
    position: relative;
  }

  .festival-trigger {
    display: block;
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    color: var(--text);
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 0.5rem;
    padding: 0.25rem 0.5rem;
    margin: -0.25rem -0.5rem;
  }

  .festival-trigger:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  :global(.dark) .festival-trigger:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .trigger-full {
    display: none;
  }

  .trigger-short {
    display: inline;
  }

  @media (min-width: 480px) {
    .trigger-full {
      display: inline;
    }

    .trigger-short {
      display: none;
    }
  }

  .nav-select {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  .theme-btn {
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 0.375rem;
    transition: color 0.15s;
    color: #d1d5db;
    background: none;
    border: none;
  }

  .theme-btn:hover {
    color: #9ca3af;
  }

  :global(.dark) .theme-btn {
    color: #9ca3af;
  }

  :global(.dark) .theme-btn:hover {
    color: #e5e7eb;
  }

  .icon-moon {
    display: block;
  }

  .icon-sun {
    display: none;
  }

  :global(.dark) .icon-moon {
    display: none;
  }

  :global(.dark) .icon-sun {
    display: block;
  }
</style>
