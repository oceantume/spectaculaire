---
import type { Festival } from "../types";

type Props = {
  festival: Festival;
  otherFestivals: Festival[];
};

const { festival, otherFestivals } = Astro.props;
---

<div class="nav-bar">
  <div data-nav-dropdown class="nav-dropdown">
    <button type="button" data-nav-toggle class="nav-title-btn">
      {festival.name}
      <span class="nav-arrow">▾</span>
    </button>
    <div data-nav-menu class="nav-menu hidden">
      {
        otherFestivals.map((f) => (
          <a href={`/${f.slug}/`} class="nav-menu-item">
            {f.name}
          </a>
        ))
      }
    </div>
  </div>
  <button type="button" data-theme-toggle class="theme-btn" aria-label="Basculer le mode sombre">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class="icon-moon"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
    </svg>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class="icon-sun"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <line x1="12" y1="2" x2="12" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="12" y1="20" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="2" y1="12" x2="4" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="20" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="4.93" y1="4.93" x2="6.34" y2="6.34" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="17.66" y1="17.66" x2="19.07" y2="19.07" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="4.93" y1="19.07" x2="6.34" y2="17.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="17.66" y1="6.34" x2="19.07" y2="4.93" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    </svg>
  </button>
</div>
<script>
  import "../scripts/theme";
  import "../scripts/nav-dropdown";
</script>

<style>
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .nav-dropdown {
    position: relative;
    display: inline-block;
  }

  .nav-title-btn {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    border-radius: 0.5rem;
    padding: 0.25rem 0.5rem;
    margin: -0.25rem -0.5rem;
    transition: background-color 0.15s;
    color: var(--text);
    background: none;
    border: none;
  }

  .nav-title-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  :global(.dark) .nav-title-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .nav-arrow {
    font-size: 1rem;
    line-height: 1.5rem;
    align-self: center;
  }

  .nav-menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 0.25rem;
    background-color: var(--bg-elevated);
    border-radius: 0.375rem;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--border);
    min-width: max-content;
    z-index: 30;
  }

  .nav-menu-item {
    display: block;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .nav-menu-item:hover {
    background-color: var(--bg-hover);
  }

  :global(.dark) .nav-menu-item:hover {
    background-color: #374151;
  }

  .theme-btn {
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 0.375rem;
    transition: color 0.15s;
    color: #d1d5db;
    background: none;
    border: none;
  }

  .theme-btn:hover {
    color: #9ca3af;
  }

  :global(.dark) .theme-btn {
    color: #9ca3af;
  }

  :global(.dark) .theme-btn:hover {
    color: #e5e7eb;
  }

  .icon-moon {
    display: block;
  }

  .icon-sun {
    display: none;
  }

  :global(.dark) .icon-moon {
    display: none;
  }

  :global(.dark) .icon-sun {
    display: block;
  }
</style>
