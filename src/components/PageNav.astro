---
import type { Festival } from "../types";

type Props = {
  festival: Festival;
  allFestivals: Festival[];
};

const { festival, allFestivals } = Astro.props;
---

<div class="nav-bar">
  <button
    type="button"
    class="festival-trigger"
    commandfor="festival-dialog"
    command="show-modal"
  >
    <span class="trigger-full">{festival.name}</span>
    <span class="trigger-short">{festival.shortName}</span>
    <svg
      class="trigger-caret"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  <div class="nav-right">
    <a href="/search" class="search-btn" aria-label="Rechercher un artiste">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </a>
    <button type="button" data-theme-toggle class="theme-btn" aria-label="Basculer le mode sombre">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="icon-moon"
      >
      <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
    </svg>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class="icon-sun"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <line x1="12" y1="2" x2="12" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"
      ></line>
      <line x1="12" y1="20" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"
      ></line>
      <line x1="2" y1="12" x2="4" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"
      ></line>
      <line x1="20" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"
      ></line>
      <line
        x1="4.93"
        y1="4.93"
        x2="6.34"
        y2="6.34"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></line>
      <line
        x1="17.66"
        y1="17.66"
        x2="19.07"
        y2="19.07"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></line>
      <line
        x1="4.93"
        y1="19.07"
        x2="6.34"
        y2="17.66"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></line>
      <line
        x1="17.66"
        y1="6.34"
        x2="19.07"
        y2="4.93"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></line>
    </svg>
  </button>
  </div>
</div>

<dialog id="festival-dialog" class="festival-dialog" closedby="any">
  <div class="festival-dialog-header">
    <span class="festival-dialog-title">Spectaculaire</span>
    <button
      type="button"
      class="festival-dialog-close"
      commandfor="festival-dialog"
      command="close"
      aria-label="Fermer"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <ul class="festival-list">
    {
      allFestivals.map((f) => (
        <li>
          <a
            href={`/${f.slug}`}
            class="festival-item"
            aria-current={f.slug === festival.slug ? "page" : undefined}
          >
            <span class="festival-name">{f.name}</span>
            <span class="festival-location">{f.region}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="festival-dialog-notice">D'autres festivals seront ajoutés prochainement.</p>
</dialog>

<script>
  import "../scripts/theme";
</script>


<style is:global>
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 0.375rem;
    color: #d1d5db;
    transition: color 0.15s;
  }

  .search-btn:hover {
    color: #9ca3af;
  }

  .dark .search-btn {
    color: #9ca3af;
  }

  .dark .search-btn:hover {
    color: #e5e7eb;
  }

  .trigger-caret {
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .festival-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    color: var(--text);
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 0.5rem;
    padding: 0.25rem 0.5rem;
    margin: -0.25rem -0.5rem;
  }

  .festival-trigger:hover {
    background-color: var(--overlay-hover);
  }

  .dark .festival-trigger:hover {
    background-color: var(--overlay-hover);
  }

  .trigger-full {
    display: none;
  }

  .trigger-short {
    display: inline;
  }

  @media (min-width: 480px) {
    .trigger-full {
      display: inline;
    }

    .trigger-short {
      display: none;
    }
  }

  .theme-btn {
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 0.375rem;
    transition: color 0.15s;
    color: #d1d5db;
    background: none;
    border: none;
  }

  .theme-btn:hover {
    color: #9ca3af;
  }

  .dark .theme-btn {
    color: #9ca3af;
  }

  .dark .theme-btn:hover {
    color: #e5e7eb;
  }

  .icon-moon {
    display: block;
  }

  .icon-sun {
    display: none;
  }

  .dark .icon-moon {
    display: none;
  }

  .dark .icon-sun {
    display: block;
  }

  /* Festival picker dialog */
  .festival-dialog {
    margin: 0;
    padding: 0;
    border: none;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    background-color: var(--bg);
    color: var(--text);
    flex-direction: column;
    transform-origin: top left;
  }

  .festival-dialog[open] {
    display: flex;
  }

  .festival-dialog::backdrop {
    background: var(--backdrop);
  }

  @media (min-width: 640px) {
    .festival-dialog {
      margin: auto;
      max-width: 42rem;
      width: 90vw;
      height: auto;
      max-height: 85dvh;
      border-radius: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .festival-dialog {
      opacity: 0;
      transform: scale(0.95);
      transition:
        opacity 0.25s ease-out,
        transform 0.25s ease-out,
        display 0.25s allow-discrete,
        overlay 0.25s allow-discrete;
    }

    .festival-dialog[open] {
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      .festival-dialog[open] {
        opacity: 0;
        transform: scale(0.95);
      }
    }

    .festival-dialog::backdrop {
      background-color: transparent;
      transition: background-color 0.25s ease-out;
    }

    .festival-dialog[open]::backdrop {
      background-color: var(--backdrop);
    }

    @starting-style {
      .festival-dialog[open]::backdrop {
        background-color: transparent;
      }
    }
  }

  .festival-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .festival-dialog-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .festival-dialog-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-dim);
    padding: 0.25rem;
    border-radius: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .festival-dialog-close:hover {
    color: var(--text);
    background-color: var(--overlay-hover);
  }

  .dark .festival-dialog-close:hover {
    background-color: var(--overlay-hover);
  }

  .festival-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    overflow-y: auto;
  }

  .festival-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    color: var(--text);
    gap: 1rem;
  }

  .festival-item:hover {
    background-color: var(--overlay-hover);
  }

  .dark .festival-item:hover {
    background-color: rgba(255, 255, 255, 0.07);
  }

  .festival-item[aria-current="page"] {
    font-weight: 700;
  }

  .festival-name {
    flex: 1;
  }

  .festival-location {
    font-size: 0.8125rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .festival-dialog-notice {
    margin-top: auto;
    padding: 0.75rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
    border-top: 1px solid var(--border);
    flex-shrink: 0;
    text-align: center;
  }
</style>
