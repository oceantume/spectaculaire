---
import type { Festival } from "../types";

type Props = {
  festival: Festival;
  otherFestivals: Festival[];
};

const { festival, otherFestivals } = Astro.props;
---

<div class="flex items-center justify-between mb-4">
  <div data-nav-dropdown class="relative inline-block">
    <button
      type="button"
      data-nav-toggle
      class="text-2xl font-bold flex items-center gap-2 cursor-pointer rounded-lg px-2 py-1 -mx-2 -my-1 transition-colors dark:text-gray-100 hover:bg-black/5 dark:hover:bg-white/10"
    >
      {festival.name}
      <span class="text-base leading-none self-center">▾</span>
    </button>
    <div data-nav-menu class="hidden absolute top-full left-0 mt-1 bg-white dark:bg-gray-800 rounded shadow-lg border border-gray-200 dark:border-gray-700 min-w-max z-30">
      {
        otherFestivals.map((f) => (
          <a
            href={`/${f.slug}/`}
            class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700"
          >
            {f.name}
          </a>
        ))
      }
    </div>
  </div>
  <button
    type="button"
    data-theme-toggle
    class="cursor-pointer p-1 rounded transition-colors text-gray-300 hover:text-gray-400 dark:text-gray-400 dark:hover:text-gray-200"
    aria-label="Basculer le mode sombre"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class="dark:hidden"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
    </svg>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class="hidden dark:block"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <line x1="12" y1="2" x2="12" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="12" y1="20" x2="12" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="2" y1="12" x2="4" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="20" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="4.93" y1="4.93" x2="6.34" y2="6.34" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="17.66" y1="17.66" x2="19.07" y2="19.07" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="4.93" y1="19.07" x2="6.34" y2="17.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
      <line x1="17.66" y1="6.34" x2="19.07" y2="4.93" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    </svg>
  </button>
</div>
<script>
  import "../scripts/theme";
  import "../scripts/nav-dropdown";
</script>
