---
type Props = { src: string };
const { src } = Astro.props;
---

<dialog id="artist-dialog" data-src={src}>
  <div id="artist-dialog-content"></div>
</dialog>
<script>
  import "../scripts/artist-dialog";
</script>

<style is:global>
  #artist-dialog {
    border-radius: 0.75rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    padding: 0;
    max-width: 32rem;
    width: 100%;
    background: transparent;
    border: none;
  }

  #artist-dialog::backdrop {
    background-color: var(--backdrop);
    transition: background-color 0.2s ease-out;
    @starting-style {
      background-color: transparent;
    }
  }

  #artist-dialog-content {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-elevated);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    #artist-dialog {
      opacity: 0;
      transform: scale(0.95) translateY(6px);
      transition:
        opacity 0.2s ease-out,
        transform 0.2s ease-out,
        display 0.2s allow-discrete,
        overlay 0.2s allow-discrete;
    }

    #artist-dialog[open] {
      opacity: 1;
      transform: scale(1);
    }

    @starting-style {
      #artist-dialog[open] {
        opacity: 0;
        transform: scale(0.95) translateY(6px);
      }
    }
  }

  .dialog-img-header {
    position: relative;
  }

  .dialog-cover-img {
    width: 100%;
    height: 16rem;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .dialog-video {
    width: 100%;
    height: 16rem;
    display: block;
    border: none;
  }

  .dialog-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.2), transparent);
  }

  .dialog-img-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 1rem;
  }

  .dialog-title-onimg {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .dialog-subtitle-onimg {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .dialog-close-onimg {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .dialog-close-onimg:hover {
    color: #ffffff;
  }

  .dialog-play-btn {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background-color: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    border-radius: 9999px;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
  }

  .dialog-play-btn:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .dialog-play-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .dialog-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.5rem;
  }

  .dialog-header-main {
    flex: 1;
    min-width: 0;
  }

  .dialog-title {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .dialog-subtitle {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--text-muted);
    margin: 0;
  }

  .dialog-close {
    color: var(--dialog-close-color);
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .dialog-close:hover {
    color: var(--dialog-close-hover);
  }

  .dialog-genre-wrap {
    padding: 0.75rem 1rem 0.25rem;
  }

  .dialog-genre-badge {
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--dialog-genre-bg);
    color: var(--dialog-genre-text);
    display: inline-block;
  }

  .dialog-description {
    padding: 0 1rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--text-secondary);
    white-space: pre-line;
    margin: 0;
  }

  .dialog-description--placeholder {
    font-style: italic;
    opacity: 0.5;
  }

  .dialog-links-wrap {
    padding: 0 1rem 1rem;
  }

  .dialog-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    list-style: none;
    margin: 0 0 0 -1.5rem;
    clip-path: inset(0 0 0 1.5rem);
    padding: 0;
  }

  .dialog-links li {
    display: flex;
    align-items: baseline;
  }

  .dialog-links li::before {
    content: "·";
    display: inline-block;
    width: 1.5rem;
    text-align: center;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .dialog-link {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--dialog-link-color);
    text-decoration: none;
  }

  .dialog-link:hover {
    text-decoration: underline;
  }
</style>
